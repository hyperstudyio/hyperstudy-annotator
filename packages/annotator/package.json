{
  "name": "@hyperstudyio/annotator",
  "version": "0.1.2",
  "description": "The HyperStudy Annotator's editor: view and correct a perception bundle's tracks, and annotate a video on its timeline.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperstudyio/hyperstudy-annotator.git",
    "directory": "packages/annotator"
  },
  "homepage": "https://docs.hyperstudy.io/annotator",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "package": "svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test-helpers.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./annotator.css": "./dist/annotator.css"
  },
  "peerDependencies": {
    "svelte": "^5.53.0"
  },
  "devDependencies": {
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.4",
    "publint": "0.3.25",
    "svelte": "^5.53.12",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0"
  }
}
