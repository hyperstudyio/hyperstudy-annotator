{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "svelte",
      "vite/client",
      "node"
    ],
    "paths": {
      "@hyperstudyio/annotator": [
        "./packages/annotator/src/lib/index.ts"
      ],
      "@hyperstudyio/annotator/*": [
        "./packages/annotator/src/lib/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "packages/annotator/src/**/*.ts",
    "packages/annotator/src/**/*.svelte"
  ]
}
